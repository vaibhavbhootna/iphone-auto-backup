<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd configuration: Auto-triggers photo backup on iPhone USB connection
  Author: Vaibhav Bhootna
  Installation: Automatically managed by install.sh
-->
<plist version="1.0">
<dict>

    <key>Label</key>
    <string>com.user.iphone-photo-backup</string>

    <!-- Photo Backup -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__SCRIPT_DIR__/backup_photos_v3.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>IPHONE_BACKUP_QUIET_NO_DEVICE</key>
        <string>1</string>
    </dict>

    <key>LaunchEvents</key>
    <dict>
        <key>com.apple.iokit.matching</key>
        <dict>
            <key>com.apple.device-attach</key>
            <dict>
                <key>idVendor</key>
                <integer>1452</integer>
                <!-- 1452 = 0x05AC = Apple Inc.; 4776 = 0x12A8 = iPhone/Apple Mobile Device Standard USB Mode -->
                <key>idProduct</key>
                <integer>4776</integer>
            </dict>
        </dict>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/iphone_photo_backup_stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/iphone_photo_backup_stderr.log</string>

    <key>KeepAlive</key>
    <false/>
    <key>RunAtLoad</key>
    <false/>
    <key>ThrottleInterval</key>
    <integer>15</integer>

</dict>
</plist>
